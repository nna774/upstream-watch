# このファイルは sh として source される。空白を含む値は必ずクォートすること。
#
# ---- 通知先 ----
# メールが第一候補。sendmail はローカルキューに入れた時点で成功を返すので、
# 両系が落ちていても postfix が滞留させて復帰後に配送する = 変化を取りこぼさない。
# 秘密情報も要らない。
# Slack に出したいなら「チャンネルにメールを送る」アドレスを足す。
# キューの恩恵を受けたまま Slack に出る (webhook と違って落ちても消えない)。
MAIL_TO=root
# MAIL_TO='"#channel (Slack)" <xxxx@your-team.slack.com>, root@example.net'
# SENDMAIL=/usr/sbin/sendmail

# 以下はメールが投函できなかったときだけ試される。
# ntfy は AAAA を持ち plain text を POST できる (jq も不要)。
# ntfy.sh の topic は名前を知っている者全員が読めるので、長いランダム文字列にする
# (プレースホルダのまま有効にすると経路情報が誰にでも読める topic に飛ぶ)。
# NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic

# Slack は AAAA を持たない v4 オンリーで、キューも持たない。
# v4 が落ちる事故を通知したい用途には通知経路ごと死ぬ。使う場合は jq が必要。
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# ---- 10-edgeos-bgp ----
# EdgeOS は disable-password-authentication 前提なので鍵認証のみ。
# systemd 側で ProtectHome=true にしてあるため鍵は /etc/upstream-watch に置く。
ROUTER_SSH=uwatch@192.0.2.254
ROUTER_SSH_OPTS='-o BatchMode=yes -o ConnectTimeout=10 -i /etc/upstream-watch/id_ed25519'

# ---- 20-mtr-upstream ----
# UPSTREAM_MTR_HOPS=4
# UPSTREAM_MTR_COUNT=5

# ---- 30-ripe-upstream (既定では install しない) ----
# 上流 AS 自身が統計を公開しているなら不要。入れる場合は両方必須
# RIPE_ASN=64512
# RIPE_PREFIX=192.0.2.0/24
# RIPEstat は 1 日 1 回しか更新されないので叩く間隔を絞る
# MIN_INTERVAL_RIPE_UPSTREAM=3600

# ---- 共通 ----
# 変化を検知したら測り直し、再現したときだけ通知する probe (空白区切り)。
# BGP 側はフラップそのものを知りたいので入れない。
CONFIRM_PROBES='mtr-upstream'
